# Реестр моделей: сам знает, какие серверы подняты и на каких портах, и какой
# из них речевой (ASR). С ним LM_BACKEND можно не задавать — он остаётся
# запасным списком, если реестр не ответил.
#LM_REGISTRY=http://your-server:7000

# Адрес OpenAI-совместимого бэкенда. Серверов может быть несколько — через
# запятую; модели всех серверов попадут в один список, и запрос уйдёт на тот,
# где живёт выбранная модель:
#   LM_BACKEND=http://your-server:8080,http://your-server:8081
LM_BACKEND=http://127.0.0.1:8080

# Что слушать
HOST=0.0.0.0
PORT=5900

# Токен к бэкенду модели (если он его требует). Раньше вводился в браузере.
LM_BACKEND_TOKEN=

# Регистрация новых пользователей: 1 — открыта, 0 — закрыта
ALLOW_REGISTRATION=1

# Ставить куку сессии только по https (включайте, если проект за TLS)
COOKIE_SECURE=0
